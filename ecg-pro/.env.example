DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEVICE_ID="ECG-001"

BOOTSTRAP_DEVICE_ID="ECG-001"
# Required: use the imp/kWh value printed on your meter; 1600 is an example.
BOOTSTRAP_METER_CONSTANT="1600"
BOOTSTRAP_DEVICE_SECRET="replace-with-long-random-secret"
# Optional but recommended for customer claiming. Print this code/QR on the physical unit.
BOOTSTRAP_DEVICE_CLAIM_CODE="replace-with-claim-code"

# DEVELOPMENT ONLY. If true, an unclaimed legacy device with no claim code can be claimed by ID.
# Keep false in production.
ALLOW_INSECURE_DEVICE_CLAIM=false

DASHBOARD_USERNAME="admin"
DASHBOARD_PASSWORD="replace-with-a-separate-random-secret"
NODE_ENV="development"
PORT=3000
LOG_LEVEL="info"

ENABLE_TEST_RESET=false
RESET_API_URL="http://localhost:3000"
