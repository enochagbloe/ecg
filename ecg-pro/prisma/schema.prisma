generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id              String           @id @default(cuid())
  hardwareId      String           @unique
  name            String?
  apiKeyHash      String
  claimCodeHash   String?
  meterConstant   Int
  isActive        Boolean          @default(true)
  lastSeenAt      DateTime?        @db.Timestamptz(3)
  firmwareVersion String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  pulseEvents     PulseEvent[]
  meterState      MeterState?
  ownership       DeviceOwnership?
  settings        DeviceSettings?
  meterPeriods    MeterPeriod[]
}

model CustomerUser {
  id           String            @id @default(cuid())
  fullName     String
  email        String            @unique
  passwordHash String
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  sessions     CustomerSession[]
  devices      DeviceOwnership[]
}

model CustomerSession {
  id        String       @id @default(cuid())
  userId    String
  user      CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String       @unique
  expiresAt DateTime     @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model DeviceOwnership {
  id        String       @id @default(cuid())
  userId    String
  user      CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String       @unique
  device    Device       @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

model PulseEvent {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  sequence   BigInt
  occurredAt DateTime @db.Timestamptz(3)
  receivedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([deviceId, sequence])
  @@index([deviceId, occurredAt])
  @@index([deviceId, receivedAt])
}

model MeterState {
  deviceId       String    @id
  device         Device    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  totalPulses    BigInt    @default(0)
  lastSequence   BigInt?
  lastPulseAt    DateTime? @db.Timestamptz(3)
  lastIntervalMs BigInt?
  energyKWh      Float     @default(0)
  powerKw        Float     @default(0)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
}

model DeviceSettings {
 deviceId String @id
 device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
 bootId String?
 bootFirstSeenAt DateTime? @db.Timestamptz(3)
 bootHead BigInt?
 firmwareVersion String?
 pendingConstant Int?
 pendingLabel String?
 requestedAt DateTime? @db.Timestamptz(3)
 expectedBootId String?
 requestId String?
 completedRequestId String?
 armedAt DateTime? @db.Timestamptz(3)
}
model MeterPeriod {
 revision Int @unique @default(autoincrement())
 id String @id @default(cuid())
 deviceId String
 device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
 startSequence BigInt
 meterConstant Int
 label String
 effectiveAt DateTime @default(now()) @db.Timestamptz(3)
 confirmedBootId String?
 @@index([deviceId, startSequence])
}

model DeviceBoot {
 deviceId String
 bootId String
 bootHead BigInt
 firstSeenAt DateTime @default(now()) @db.Timestamptz(3)
 @@id([deviceId,bootId])
}
